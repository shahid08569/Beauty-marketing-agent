# API Keys for Beauty Marketing Agent
# Rename this file to .env and insert your actual API keys

# D-ID API Key (for talking avatar headshots)
DID_API_KEY=your_did_api_key_here

# Replicate API Token (for Kling AI v1.6 and Minimax Video-01 motion diffusion)
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Fal.ai API Key (optional fallback for Wan 2.1 & Kling AI)
FAL_KEY=your_fal_api_key_here

# HeyGen API Key (optional fallback)
HEYGEN_API_KEY=your_heygen_api_key_here
